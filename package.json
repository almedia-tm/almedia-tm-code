  "scripts": {
    "test": "node --test scripts/**/*.test.js",
    "lint": "node -e \"const fs=require('fs');const files=require('fast-glob').sync(['**/*.js','!node_modules/**']);files.forEach(f=>{try{require('child_process').execSync('node --check '+f,{stdio:'pipe'})}catch(e){console.error(f, e.stderr.toString());process.exit(1)}});console.log('All JS files pass --check')\""
  },
  "dependencies": {
    "prompts": "^2.4.2",
    "which": "^4.0.0"
  },
  "optionalDependencies": {
    "clipboardy": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "claude-code",
