  "description": "Opinionated, token-optimized Claude Code bootstrap with curated agents, slash commands, skills, output styles, and optional memory/compression layers.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Almedia <ai@almedia.co>",
  "homepage": "https://github.com/almedia-tm/almedia-tm-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/almedia-tm/almedia-tm-code.git"
  },
  "bugs": {
    "url": "https://github.com/almedia-tm/almedia-tm-code/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
