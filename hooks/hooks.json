{
  "description": "almedia-code hooks: activates the output style on session start; nudges to read codemaps before grep/find on Bash.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/style-activate.js\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/codemap-nudge.js\""
          }
        ]
      }
    ]
  }
}
